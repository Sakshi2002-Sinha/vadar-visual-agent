# ============================================================
# VADAR Visual Agent – Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control.
# ============================================================

# ------------------------------------------------------------
# LLM API (Gemini via OpenAI-compatible endpoint)
# ------------------------------------------------------------

# Your Gemini key (required for code generation)
GEMINI_API_KEY=your-gemini-key-here

# Optional OpenAI-compatible base URL for Gemini
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# LLM model used for spatial-reasoning code generation
LLM_MODEL=google/gemini-2.0-flash

# Maximum tokens to generate per code completion
OPENAI_MAX_TOKENS=1500

# Sampling temperature (0 = deterministic, 1 = creative)
OPENAI_TEMPERATURE=0.3

# ------------------------------------------------------------
# HuggingFace Model Cache
# ------------------------------------------------------------

# Where to store downloaded HuggingFace model weights.
# Defaults to ~/.cache/huggingface if not set.
# HF_HOME=/mnt/large_disk/.cache/huggingface

# ------------------------------------------------------------
# CUDA / GPU Settings
# ------------------------------------------------------------

# Set to "1" to force CPU even when a GPU is present.
# FORCE_CPU=0

# CUDA device index to use (0 = first GPU)
# CUDA_VISIBLE_DEVICES=0

# ------------------------------------------------------------
# Model Paths (optional overrides)
# ------------------------------------------------------------

# Use a locally downloaded or fine-tuned model instead of the
# HuggingFace Hub ID.
# OBJECT_DETECTION_MODEL=IDEA-Research/grounding-dino-base
# DEPTH_ESTIMATION_MODEL=lpiccinelli/unidepth-v2-vitl14
# SEGMENTATION_MODEL=facebook/sam2-hiera-large
# VQA_MODEL=allenai/Molmo-7B-D-0924

# ------------------------------------------------------------
# Evaluation & Output
# ------------------------------------------------------------

# Default output directory for evaluation results
OUTPUT_DIR=outputs

# Whether to save visual traces (PNG files) during evaluation
# Set to "0" to disable and speed up evaluation
SAVE_TRACES=1

# Whether to save generated Python code files
SAVE_CODE=1
